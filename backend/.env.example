# Optional LLM. Leave empty to run fully offline (rule-based extraction + structured answers).
# LLM_PROVIDER: "gemini" or "openai"
LLM_PROVIDER=
LLM_API_KEY=
# Optional model override (defaults: gemini-1.5-flash / gpt-4o-mini)
LLM_MODEL=

# Database (SQLite). Relative to /backend.
NWIS_DB_PATH=nwis.db

# Default offset radius for alerts and stats
NWIS_DEFAULT_RADIUS_KM=15
